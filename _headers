  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' cdn.jsdelivr.net kit.fontawesome.com 'unsafe-inline'; style-src 'self' 'unsafe-inline' fonts.googleapis.com cdn.jsdelivr.net; font-src 'self' fonts.gstatic.com kit.fontawesome.com ka-f.fontawesome.com; img-src 'self' https: data:; connect-src 'self'; frame-ancestors 'self';
